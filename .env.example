# Keep real secrets in the sandbox/production environment, not source control.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set a private publisher key of at least 16 characters. Unset means publishing is locked.
ADMIN_SECRET=
# Optional persistent writable game build directory. Default: storage/games
GAME_STORAGE_DIR=
# Public operator contact and canonical URL, required before monetised launch.
PUBLISHER_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=
# Enable only after approval, real ad units and a Google-certified consent flow are configured.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_COLLECTION=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
